# Google Cloud Service Account Credentials for Vercel Serverless
GCP_PROJECT_ID="your-gcp-project-id"
GCP_CLIENT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# Explicit workbook ID strongly recommended for every writable environment.
# Confirm staging/test ownership before local test writes; title discovery is for reads.
GOOGLE_SHEET_TITLE="PS Cadet College - Master Examination Database"
GOOGLE_SHEET_ID="your-confirmed-staging-workbook-id"

# Auth.js Google Sign-In (personal Google accounts are allowed)
AUTH_SECRET="generate-a-long-random-secret"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Shared serverless rate limiting (required in production, including Vercel previews)
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Dedicated server-only HMAC key for pseudonymizing rate-limit identifiers.
# Generate independently from AUTH_SECRET, for example: openssl rand -base64 32
RATE_LIMIT_HASH_SECRET="generate-an-independent-long-random-secret"

# Optional rate-limit overrides. Defaults are shown below.
RATE_LIMIT_AUTH_SIGN_IN_MAX="60"
RATE_LIMIT_AUTH_SIGN_IN_WINDOW_SECONDS="600"
RATE_LIMIT_AUTH_VERIFIED_EMAIL_MAX="10"
RATE_LIMIT_AUTH_VERIFIED_EMAIL_WINDOW_SECONDS="900"
RATE_LIMIT_STAFF_SESSION_MAX="30"
RATE_LIMIT_STAFF_SESSION_WINDOW_SECONDS="300"
RATE_LIMIT_DATABASE_READ_MAX="30"
RATE_LIMIT_DATABASE_READ_WINDOW_SECONDS="300"
RATE_LIMIT_DATABASE_REFRESH_MAX="5"
RATE_LIMIT_DATABASE_REFRESH_WINDOW_SECONDS="300"
RATE_LIMIT_MARKS_WRITE_MAX="10"
RATE_LIMIT_MARKS_WRITE_WINDOW_SECONDS="300"
RATE_LIMIT_RESULT_PUBLICATION_MAX="60"
RATE_LIMIT_RESULT_PUBLICATION_WINDOW_SECONDS="600"

# Write coordination: use the existing Upstash instance with a separate namespace.
# Required in ALL runtimes that write, including local development. No memory fallback.
# Generate a separate stable secret; changing it changes receipt ownership/key hashes.
WRITE_COORDINATION_SECRET="generate-an-independent-stable-write-secret"
WRITE_COORDINATION_NAMESPACE="your-workbook-specific-namespace"
# All writers of the SAME workbook MUST share both secret and namespace.
# Separate staging/production workbooks use isolated namespaces (e.g. pscc-exam-dev).
# Never change identity while other writers or unresolved operations remain active.
# Reads succeeding does not mean writes are ready.
# Required: Sheets credentials, explicit workbook ID, Write_Receipts, Audit_Log,
# and the existing Redis ready sentinel; production schema changes need approval.
# See docs/task-3.2-write-safety.md. Do not initialize over unresolved operations.

# Scoped resource reads share a bounded per-actor read budget.
RATE_LIMIT_SCOPED_READ_MAX=120
RATE_LIMIT_SCOPED_READ_WINDOW_SECONDS=300
